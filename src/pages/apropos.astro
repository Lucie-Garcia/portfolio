---
import Layout from "../layouts/Layout.astro";
import AnimatedWaves from "../components/AnimatedWaves.astro";
---

<Layout>
    <main class="relative min-h-screen overflow-hidden pt-24">
        <AnimatedWaves class="skills-page-waves" />

        <div class="relative z-10 mx-auto max-w-6xl px-6 py-12 sm:py-16">
            <header class="mb-12 text-center">
                <p
                    class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-primary"
                >
                    À propos
                </p>
                <h1 class="text-4xl font-bold sm:text-6xl">
                    Bonjour, moi c’est Lucie.
                </h1>
            </header>

            <section
                class="grid items-center gap-8 md:grid-cols-[1.15fr_.85fr]"
            >
                <div
                    class="rounded-box border border-base-300 bg-base-200/90 p-7 shadow-sm backdrop-blur-sm sm:p-9"
                >
                    <p class="text-lg leading-8 sm:text-xl">
                        J’ai 20 ans et je suis basée à Belfort, ses alentours et
                        Besançon. Étudiante en deuxième année de Métiers du
                        Multimédia et de l’Internet, je me suis tournée vers la
                        branche développement.
                    </p>
                    <p class="mt-5 leading-7 opacity-75">
                        J’aime imaginer une interface, réfléchir à son
                        fonctionnement, écrire du code et voir petit à petit une
                        idée devenir un projet concret.
                    </p>
                </div>

                <div class="mx-auto aspect-[4/5] w-full max-w-sm">
                    <div
                        class="group relative h-full w-full overflow-hidden rounded-box border border-primary/30 bg-base-200/80 shadow-sm"
                    >
                        <div
                            class="absolute inset-0 grid place-items-center text-center"
                        >
                            <div>
                                <span
                                    class="mx-auto mb-4 flex h-20 w-20 items-center justify-center rounded-full border border-primary/40 bg-base-100 text-3xl font-bold text-primary"
                                >
                                    LG
                                </span>
                                <p class="text-sm font-semibold">Ma photo</p>
                                <p class="mt-1 text-xs opacity-60">À venir</p>
                            </div>
                        </div>
                        <div
                            class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-primary/15 to-transparent transition-transform duration-700 group-hover:translate-x-full"
                        >
                        </div>
                    </div>
                </div>
            </section>

            <section class="mt-16">
                <div class="mb-8 max-w-2xl">
                    <p
                        class="text-sm font-semibold uppercase tracking-[0.2em] text-primary"
                    >
                        Mon parcours
                    </p>
                    <h2 class="mt-3 text-3xl font-bold sm:text-4xl">
                        Pourquoi le développement ?
                    </h2>
                    <p class="mt-4 leading-7 opacity-75">
                        Une passion qui se traduit par une envie de créer, de
                        coder et de voir les idées prendre vie à l’écran.
                    </p>
                </div>

                <div class="grid gap-5 md:grid-cols-3">
                    <article
                        class="project-card rounded-box border border-base-300 bg-base-200/90 p-6 backdrop-blur-sm"
                    >
                        <span class="text-sm font-semibold text-primary"
                            >01</span
                        >
                        <h3 class="mt-3 text-xl font-semibold">Une passion</h3>
                        <p class="mt-3 leading-7 opacity-75">
                            J’ai choisi le développement avant tout parce que
                            j’aime créer, construire et résoudre des problèmes.
                        </p>
                    </article>

                    <article
                        class="project-card rounded-box border border-base-300 bg-base-200/90 p-6 backdrop-blur-sm"
                    >
                        <span class="text-sm font-semibold text-primary"
                            >02</span
                        >
                        <h3 class="mt-3 text-xl font-semibold">
                            Un environnement familier
                        </h3>
                        <p class="mt-3 leading-7 opacity-75">
                            Mes deux parents évoluent dans ce domaine, ce qui a
                            certainement influencé mon parcours.
                        </p>
                    </article>

                    <article
                        class="project-card rounded-box border border-base-300 bg-base-200/90 p-6 backdrop-blur-sm"
                    >
                        <span class="text-sm font-semibold text-primary"
                            >03</span
                        >
                        <h3 class="mt-3 text-xl font-semibold">
                            Le moment où tout prend vie
                        </h3>
                        <p class="mt-3 leading-7 opacity-75">
                            C’est ce que je préfère : grâce au code, les idées
                            deviennent concrètes et utilisables.
                        </p>
                    </article>
                </div>
            </section>

            <section
                class="mt-16 rounded-box border border-base-300 bg-base-200/90 p-6 backdrop-blur-sm sm:p-9"
            >
                <div class="mb-8 max-w-2xl">
                    <p
                        class="text-sm font-semibold uppercase tracking-[0.2em] text-primary"
                    >
                        Ma vision
                    </p>
                    <h2 class="mt-3 text-3xl font-bold sm:text-4xl">
                        Mon utilisation de l’IA
                    </h2>
                    <p class="mt-4 leading-7 opacity-75">
                        Un outil utile, mais pas un remplacement. Je l’utilise
                        pour accélérer, vérifier et enrichir mon travail.
                    </p>
                </div>

                <div class="grid gap-5 md:grid-cols-3">
                    <article>
                        <h3 class="text-lg font-semibold">
                            Pas dans l’art et le visuel
                        </h3>
                        <p class="mt-3 leading-7 opacity-75">
                            Les visuels produits par l’IA restent souvent
                            faciles à distinguer. Les présenter comme des
                            créations humaines peut donner une mauvaise image.
                        </p>
                    </article>
                    <article>
                        <h3 class="text-lg font-semibold">
                            Excellent pour le code
                        </h3>
                        <p class="mt-3 leading-7 opacity-75">
                            L’IA permet de gagner du temps, d’exposer une idée
                            et d’obtenir rapidement une base de travail à
                            tester.
                        </p>
                    </article>
                    <article>
                        <h3 class="text-lg font-semibold">
                            Un outil, pas un remplacement
                        </h3>
                        <p class="mt-3 leading-7 opacity-75">
                            Elle reste imparfaite : son travail nécessite une
                            relecture, une vérification et une vraie
                            compréhension.
                        </p>
                    </article>
                </div>
            </section>

            <section class="mt-16">
                <div class="mb-8 max-w-2xl">
                    <p
                        class="text-sm font-semibold uppercase tracking-[0.2em] text-primary"
                    >
                        Contact
                    </p>
                    <h2 class="mt-3 text-3xl font-bold sm:text-4xl">
                        Travaillons ensemble
                    </h2>
                    <p class="mt-4 leading-7 opacity-75">
                        Besoin de discuter d’un projet, d’un stage ou d’une
                        collaboration ? Laissez-moi un message.
                    </p>
                </div>

                <div class="grid gap-6 lg:grid-cols-[.75fr_1.25fr]">
                    <aside
                        class="rounded-box border border-base-300 bg-base-200/90 p-6 backdrop-blur-sm"
                    >
                        <h3 class="text-xl font-semibold">Informations</h3>
                        <dl class="mt-5 space-y-5 text-sm">
                            <div>
                                <dt class="opacity-60">Email</dt>
                                <dd class="mt-1">
                                    <a
                                        class="font-medium hover:text-primary"
                                        href="mailto:lucie@margar.fr"
                                        >lucie@margar.fr</a
                                    >
                                </dd>
                            </div>
                            <div>
                                <dt class="opacity-60">Téléphone</dt>
                                <dd class="mt-1">
                                    <a
                                        class="font-medium hover:text-primary"
                                        href="tel:+33783447241"
                                        >+33 7 83 44 72 41</a
                                    >
                                </dd>
                            </div>
                            <div>
                                <dt class="opacity-60">Adresse</dt>
                                <dd class="mt-1">
                                    5 rue des vergers<br />90400 Sevenans,
                                    France
                                </dd>
                            </div>
                            <div>
                                <dt class="opacity-60">CV</dt>
                                <dd class="mt-1">
                                    <a
                                        class="font-medium hover:text-primary"
                                        href="/cv.pdf"
                                        target="_blank">Télécharger mon CV</a
                                    >
                                </dd>
                            </div>
                            <div>
                                <dt class="opacity-60">Réseaux</dt>
                                <dd class="mt-1 flex gap-3">
                                    <a
                                        class="font-medium hover:text-primary"
                                        href="https://www.linkedin.com/in/lucie-garcia"
                                        target="_blank"
                                        rel="noreferrer">LinkedIn</a
                                    >
                                    <a
                                        class="font-medium hover:text-primary"
                                        href="https://github.com/lucie-garcia"
                                        target="_blank"
                                        rel="noreferrer">GitHub</a
                                    >
                                </dd>
                            </div>
                        </dl>
                    </aside>

                    <form
                        class="rounded-box border border-base-300 bg-base-200/90 p-6 backdrop-blur-sm sm:p-8"
                    >
                        <h3 class="text-xl font-semibold mb-9">
                            Envoyer un message
                        </h3>
                        <div class="grid gap-5 sm:grid-cols-2">
                            <label class="form-control">
                                <span class="label-text mb-2">Nom</span>
                                <input
                                    class="input input-bordered w-full"
                                    type="text"
                                    name="name"
                                    required
                                />
                            </label>
                            <label class="form-control">
                                <span class="label-text mb-2">Email</span>
                                <input
                                    class="input input-bordered w-full"
                                    type="email"
                                    name="email"
                                    required
                                />
                            </label>
                            <label class="form-control sm:col-span-2">
                                <span class="label-text mb-2">Sujet</span>
                                <input
                                    class="input input-bordered w-full"
                                    type="text"
                                    name="subject"
                                    required
                                />
                            </label>
                            <label class="form-control sm:col-span-2">
                                <span class="label-text mb-2">Message</span>
                                <textarea
                                    class="textarea textarea-bordered min-h-36 w-full"
                                    name="message"
                                    required></textarea>
                            </label>
                        </div>
                        <button class="btn btn-primary mt-6" type="submit"
                            >Envoyer le message</button
                        >
                    </form>
                </div>
            </section>
        </div>
    </main>
</Layout>
