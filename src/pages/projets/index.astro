---
import Layout from "../../layouts/Layout.astro";
import Projects from "../../components/Projects.astro";
import AnimatedWaves from "../../components/AnimatedWaves.astro";
---

<Layout>
  <main class="pt-24">
    <section class="relative min-h-screen overflow-hidden">
      <AnimatedWaves class="skills-page-waves" />
      <div class="relative z-10">
        <header class="mx-auto max-w-3xl px-6 pb-2 pt-12 text-center">
          <p
            class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-primary"
          >
            Portfolio
          </p>
          <h1 class="text-4xl font-bold sm:text-6xl">Tous mes projets</h1>
          <p
            class="mx-auto mt-5 max-w-2xl text-base leading-7 opacity-75 sm:text-lg"
          >
            Une sélection de projets réalisés en design, développement et
            communication numérique.
          </p>
        </header>

        <Projects showHeading={false} />
      </div>
    </section>
  </main>
</Layout>
