---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<canvas
  class={`animated-waves ${className}`}
  aria-hidden="true"
  data-animated-waves
></canvas>

<script>
  const canvases = document.querySelectorAll<HTMLCanvasElement>(
    "[data-animated-waves]",
  );

  canvases.forEach((canvas) => {
    if (canvas.dataset.initialized === "true") return;
    canvas.dataset.initialized = "true";

    const container = canvas.parentElement;
    const context = canvas.getContext("2d");
    if (!container || !context) return;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    let width = 0;
    let height = 0;
    let mobile = false;
    let waveX = 0;
    let waveY = 0;
    let presence = 0;
    let energy = 0;
    let mouseX = -9999;
    let mouseY = -9999;
    let lastMouseX = 0;
    let lastMouseY = 0;
    const start = performance.now();

    const layers = [
      { y: 0.68, amplitude: 34, frequency: 1.3, speed: 0.35, phase: 0, color: "rgba(243,220,203,.55)" },
      { y: 0.75, amplitude: 28, frequency: 1.8, speed: -0.5, phase: 1.7, color: "rgba(232,191,179,.5)" },
      { y: 0.82, amplitude: 24, frequency: 2.4, speed: 0.65, phase: 3.1, color: "rgba(251,235,223,.6)" },
      { y: 0.89, amplitude: 20, frequency: 3, speed: -0.8, phase: 4.6, color: "rgba(216,167,160,.45)" },
      { y: 0.1, amplitude: 22, frequency: 1.6, speed: -0.4, phase: 2.2, color: "rgba(232,191,179,.4)", top: true },
      { y: 0.17, amplitude: 18, frequency: 2.2, speed: 0.55, phase: 5, color: "rgba(243,220,203,.45)", top: true },
    ];

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const bounds = canvas.getBoundingClientRect();
      const nextWidth = Math.round(bounds.width || canvas.clientWidth);
      const nextHeight = Math.round(bounds.height || canvas.clientHeight);

      if (!nextWidth || !nextHeight) return;

      width = nextWidth;
      height = nextHeight;
      mobile = width < 640;

      const pixelWidth = Math.round(width * dpr);
      const pixelHeight = Math.round(height * dpr);
      if (canvas.width === pixelWidth && canvas.height === pixelHeight) return;

      canvas.width = pixelWidth;
      canvas.height = pixelHeight;
      context.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function draw(now: number) {
      const time = reduce ? 0 : (now - start) / 1000;
      const bounds = canvas.getBoundingClientRect();
      const active = finePointer && !reduce && mouseX > -1000;

      if (active) {
        if (presence < 0.02) {
          waveX = mouseX - bounds.left;
          waveY = mouseY - bounds.top;
          lastMouseX = mouseX;
          lastMouseY = mouseY;
        }
        const speed = Math.hypot(mouseX - lastMouseX, mouseY - lastMouseY);
        lastMouseX = mouseX;
        lastMouseY = mouseY;
        energy += ((Math.min(speed, 50) / 50) * 1.4 - energy) * 0.06;
        waveX += (mouseX - bounds.left - waveX) * 0.1;
        waveY += (mouseY - bounds.top - waveY) * 0.1;
      } else {
        energy *= 0.95;
      }
      presence += ((active ? 1 : 0) - presence) * 0.04;
      context.clearRect(0, 0, width, height);
      const step = mobile ? 4 : 6;

      layers.forEach((layer) => {
        const amplitude = layer.amplitude * (mobile ? 0.78 : 1);
        const frequency = layer.frequency * (mobile ? 0.55 : 1);
        const base = layer.y * height;
        const position = (waveY - base) / (height * 0.18);
        const pull = position * Math.exp(0.5 - (position * position) / 2) * presence;
        const proximity = Math.exp((-position * position) / 2) * presence;
        context.beginPath();

        for (let x = 0; x <= width + step; x += step) {
          const wave = (x / width) * frequency * Math.PI * 2;
          let y = base + amplitude * (
            Math.sin(wave + time * layer.speed + layer.phase) +
            0.5 * Math.sin(wave * 2.1 - time * layer.speed * 1.3 + layer.phase)
          );
          if (presence > 0.001) {
            const distance = x - waveX;
            y += pull * 55 * Math.exp(-(distance * distance) / (2 * 170 * 170));
            y += Math.sin(distance / 38 - time * 5) *
              Math.exp(-Math.abs(distance) / 230) * energy * 11 * proximity;
          }
          if (x === 0) context.moveTo(x, y);
          else context.lineTo(x, y);
        }

        const edge = layer.top ? 0 : height;
        const gradient = context.createLinearGradient(
          0,
          layer.top ? base + amplitude : base - amplitude,
          0,
          edge,
        );
        gradient.addColorStop(0, layer.color);
        gradient.addColorStop(1, "rgba(255,255,255,0)");
        context.strokeStyle = "rgba(255,255,255,.45)";
        context.lineWidth = 1.2;
        context.stroke();
        context.lineTo(width + step, edge);
        context.lineTo(0, edge);
        context.closePath();
        context.fillStyle = gradient;
        context.fill();
      });

      requestAnimationFrame(draw);
    }

    if (finePointer) {
      container.addEventListener("pointermove", (event) => {
        mouseX = event.clientX;
        mouseY = event.clientY;
      });
      container.addEventListener("pointerleave", () => {
        mouseX = mouseY = -9999;
      });
    }
    window.addEventListener("resize", resize);
    window.addEventListener("orientationchange", resize);
    window.addEventListener("pageshow", resize);

    const observer = new ResizeObserver(resize);
    observer.observe(canvas);

    resize();
    requestAnimationFrame(() => {
      resize();
      requestAnimationFrame(() => {
        resize();
        draw(performance.now());
      });
    });
  });
</script>
