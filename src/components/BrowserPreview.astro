---
// src/components/BrowserPreview.astro
const { url, title = "Aperçu du site" } = Astro.props;
---

<div class="mockup-browser bg-base-100 w-full border border-base-300">
    <div class="mockup-browser-toolbar">
        <div class="input">{url}</div>
    </div>

    <div class="preview relative h-96 overflow-hidden" data-width="1280">
        <iframe
            src={url}
            title={title}
            loading="lazy"
            sandbox="allow-scripts allow-same-origin"
            referrerpolicy="no-referrer"
            class="absolute top-0 left-0 border-0 origin-top-left"
            style="width:1280px;height:1000px"></iframe>
    </div>
</div>

<script>
    document.querySelectorAll<HTMLElement>(".preview").forEach((box) => {
        const frame = box.querySelector("iframe")!;
        const baseWidth = Number(box.dataset.width);
        const fit = () => {
            const scale = box.clientWidth / baseWidth;
            frame.style.transform = `scale(${scale})`;
            frame.style.height = `${box.clientHeight / scale}px`;
        };
        new ResizeObserver(fit).observe(box);
        fit();
    });
</script>
